// =======================
// Test Routes
// =======================

### Root / no Auth: Login
GET http://localhost:3000/

### Root / with Auth: Home
GET http://localhost:3000/
x-auth: test

### Home / no Auth: 401
GET http://localhost:3000/home.html

### Home / with Auth: Home
GET http://localhost:3000/home.html
x-auth: test

### Login: Login
GET http://localhost:3000/login.html

### Tasks / no Auth: 401
GET http://localhost:3000/tasks.html

### Tasks / with Auth: Tasks
GET http://localhost:3000/tasks.html
x-auth: test

// =======================
// Users
// =======================

###
POST http://localhost:3000/users
Content-Type: application/json

{
    "name": "Yoo Sangah",
    "email": "yoo_sangah@kimcom.com",
    "password": "123456789",
    "confirm_password": "123456789"
}

// Get all users
### 
GET http://localhost:3000/users?page=1&limit=2
x-auth: admin_auth

// Get specific user
### 
GET http://localhost:3000/users/4
x-auth: 123456789

// Update user
### 
PATCH http://localhost:3000/users/4
x-auth: 123456789
Content-Type: application/json

{
    "password": "987654321"
}

// Delete user
###
DELETE http://localhost:3000/users/4
x-auth: 123456789

// =======================
// Tasks
// =======================

// Create Task
###
POST http://localhost:3000/tasks
x-auth: yjhs-apologist
Content-Type: application/json

{
    "title": "Self-Sacrifice for the Eleventh Time",
    "description": "self-descriptive",
    "due_date": "2026-10-17",
    "id_user": 1,
    "status": "C",
    "tags": [1]
}